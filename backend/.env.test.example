# Copy to .env.test for local test runs. Points at a disposable test database —
# never run tests against a database you care about (the test suite creates
# and drops the full schema for isolation).
APP_ENV=test
DEBUG=true
SECRET_KEY=test-secret-key-not-for-production-use-only
DATABASE_URL=postgresql+asyncpg://ragforge:ragforge@localhost:5432/ragforge_test
REDIS_URL=redis://localhost:6379/15
CELERY_BROKER_URL=redis://localhost:6379/14
CELERY_RESULT_BACKEND=redis://localhost:6379/13
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=document_chunks_test
ANTHROPIC_API_KEY=test-key-not-used-mocked-in-tests
VOYAGE_API_KEY=test-key-not-used-mocked-in-tests
LOG_FORMAT=console
LOG_LEVEL=WARNING
