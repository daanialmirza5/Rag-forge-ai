# --- App ---
APP_ENV=development                 # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Auth / JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
DATABASE_URL=postgresql+asyncpg://ragforge:ragforge@localhost:5432/ragforge
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Vector store (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=document_chunks

# --- LLM (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=true
LLM_EFFORT=high
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Embeddings (Voyage AI) ---
VOYAGE_API_KEY=pa-your-key-here
EMBEDDING_MODEL=voyage-3-large
EMBEDDING_DIMENSIONS=1024
EMBEDDING_PROVIDER=voyage           # voyage | openai

# --- Reranking (Voyage AI) ---
RERANK_MODEL=rerank-2
RERANK_PROVIDER=voyage

# --- Retrieval tuning ---
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RETRIEVAL_FUSED_TOP_K=30
RETRIEVAL_RERANK_TOP_N=8
RETRIEVAL_HISTORY_TURNS_FOR_REWRITE=6

# --- Chunking ---
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200

# --- File storage ---
STORAGE_BACKEND=local               # local | s3
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_SIZE_MB=50
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json                     # json | console
SENTRY_DSN=
