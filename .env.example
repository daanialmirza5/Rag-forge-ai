# Copy to .env, then `docker compose up --build`. Every value below already
# has a working default for local Docker Compose use — the compose file
# pins the inter-service URLs (postgres/redis/qdrant hostnames) itself, so
# changes here to DATABASE_URL etc. only matter if you're pointing at
# services outside the compose network.
#
# --- Two ways to run this project ---
#
# 1. FREE, fully local (the default below): install Ollama
#    (https://ollama.com), run `ollama pull llama3.1:8b` and
#    `ollama pull nomic-embed-text`, then just `docker compose up --build`.
#    No API keys, no cost. Answer quality is noticeably below Claude, and
#    there's no reranking pass (LLM_PROVIDER=ollama/EMBEDDING_PROVIDER=ollama/
#    RERANK_PROVIDER=none below have no free equivalent for reranking, so
#    hybrid retrieval's fused order is used as-is).
#
# 2. Real Claude + Voyage (better quality, costs money per API call): get an
#    ANTHROPIC_API_KEY from console.anthropic.com and a VOYAGE_API_KEY from
#    dash.voyageai.com, set them below, then change LLM_PROVIDER=anthropic,
#    LLM_MODEL=claude-opus-4-8, EMBEDDING_PROVIDER=voyage,
#    EMBEDDING_MODEL=voyage-3-large, EMBEDDING_DIMENSIONS=1024,
#    RERANK_PROVIDER=voyage further down. Switching embedding providers
#    changes vector dimensions, so Qdrant's collection needs to be dropped
#    (`curl -X DELETE http://localhost:6333/collections/document_chunks`)
#    before the next backend restart recreates it at the new size — any
#    already-ingested documents will need reingesting.

# --- AI provider API keys (only used if LLM_PROVIDER/EMBEDDING_PROVIDER/
# RERANK_PROVIDER below are set to anthropic/voyage) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
VOYAGE_API_KEY=pa-your-key-here

# --- App ---
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Auth / JWT ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Postgres (used by the `postgres` compose service itself) ---
POSTGRES_USER=ragforge
POSTGRES_PASSWORD=ragforge
POSTGRES_DB=ragforge

# --- LLM ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_MAX_TOKENS=4096
LLM_ENABLE_THINKING=true
LLM_EFFORT=high
LLM_REQUEST_TIMEOUT_SECONDS=120

# --- Embeddings ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Reranking ---
RERANK_MODEL=rerank-2
RERANK_PROVIDER=none

# --- Retrieval tuning ---
RETRIEVAL_DENSE_TOP_K=50
RETRIEVAL_SPARSE_TOP_K=50
RETRIEVAL_FUSED_TOP_K=30
RETRIEVAL_RERANK_TOP_N=8
RETRIEVAL_HISTORY_TURNS_FOR_REWRITE=6

# --- Chunking ---
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200

# --- File storage ---
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=50

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Observability ---
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
